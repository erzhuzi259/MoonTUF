// Generated from original repositories signed with Python-TUF 7.0.1; not upstream test data.

///|
test "Python ed25519 repository SHA512 chain target stream and local resume" {
  let root = @crypto.decode_hex(
    "",
  ).unwrap()
  let timestamp = @crypto.decode_hex(
    "",
  ).unwrap()
  let snapshot = @crypto.decode_hex(
    "",
  ).unwrap()
  let targets = @crypto.decode_hex(
    "",
  ).unwrap()
  let client = @client.open_trusted_root(root, "2026-10-20T00:00:00Z")
    .unwrap()
    .accept_timestamp(timestamp)
    .unwrap()
    .accept_snapshot(snapshot)
    .unwrap()
    .accept_targets(targets)
    .unwrap()
  assert_true(client.ready())
  let verified = client
    .verify_top_level_target("plugins/demo.bin", b"trusted-update")
    .unwrap()
  assert_eq(verified.length(), 14L)
  assert_true(
    client.verify_top_level_target("plugins/demo.bin", b"evil") is Err(_),
  )
  let stream = client.open_top_level_stream("plugins/demo.bin").unwrap()
  stream.write(b"trusted-").unwrap()
  stream.write(b"update").unwrap()
  assert_eq(stream.finish().unwrap().sha256(), verified.sha256())
  let restored = @client.restore_state(
      client.save_state(),
      root,
      "2026-10-20T00:00:00Z",
    )
    .unwrap()
    .finish_root_chain()
    .unwrap()
  assert_eq(
    restored
    .verify_top_level_target("plugins/demo.bin", b"trusted-update")
    .unwrap()
    .sha256(),
    verified.sha256(),
  )
  assert_true(
    client
    .top_level_target_request_name("plugins/demo.bin")
    .unwrap()
    .has_prefix("plugins/"),
  )
}

